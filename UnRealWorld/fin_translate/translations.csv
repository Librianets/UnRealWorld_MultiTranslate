u_11136685f819e578a8b8;message;template;It will take me {v1} to make it.;Sen tekemiseen kuluu {v1}.;{};"{""v1"":{""printf"":""%s"",""type"":""text""}}";;;;;m;;;;;1;finnish_translation;
