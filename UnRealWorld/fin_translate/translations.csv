u_9862244f21dfd5a45a79;message;exact;Woodsman's axe;metsurinkirves;"{""ablative"":""metsurinkirveeltä"",""ablative_plural"":""metsurinkirveiltä"",""adessive"":""metsurinkirveellä"",""adessive_plural"":""metsurinkirveillä"",""allative"":""metsurinkirveelle"",""allative_plural"":""metsurinkirveille"",""elative"":""metsurinkirveestä"",""elative_plural"":""metsurinkirveistä"",""essive"":""metsurinkirveenä"",""essive_plural"":""metsurinkirveinä"",""few"":""metsurinkirvestä"",""genitive"":""metsurinkirveen"",""genitive_plural"":""metsurinkirveiden"",""illative"":""metsurinkirveeseen"",""illative_plural"":""metsurinkirveisiin"",""inessive"":""metsurinkirveessä"",""inessive_plural"":""metsurinkirveissä"",""many"":""metsurinkirvestä"",""nominative"":""metsurinkirves"",""nominative_plural"":""metsurinkirveet"",""one"":""metsurinkirves"",""other"":""metsurinkirvestä"",""partitive"":""metsurinkirvestä"",""partitive_plural"":""metsurinkirveitä"",""plural"":""metsurinkirveet"",""translative"":""metsurinkirveeksi"",""translative_plural"":""metsurinkirveiksi""}";{};;;;{};m;"{""ablative"":""m"",""ablative_plural"":""m"",""adessive"":""m"",""adessive_plural"":""m"",""allative"":""m"",""allative_plural"":""m"",""elative"":""m"",""elative_plural"":""m"",""essive"":""m"",""essive_plural"":""m"",""few"":""m"",""genitive"":""m"",""genitive_plural"":""plural"",""illative"":""m"",""illative_plural"":""m"",""inessive"":""m"",""inessive_plural"":""m"",""many"":""m"",""nominative"":""m"",""nominative_plural"":""m"",""one"":""m"",""other"":""m"",""partitive"":""m"",""partitive_plural"":""m"",""plural"":""plural"",""translative"":""m"",""translative_plural"":""m""}";;;;1;finnish_translation;
u_e0347df3f1adb4ad38a3;message;template;Would you be able and willing to escort me to {v1}? After reaching any village there I can continue on my own, but for the travel trough the wilderness I'd gladly rely on somebody who knows the route and can keep a wayfarer safe.;Voisitko ja tahtoisitko saattaa minut paikkaan {v1}? Kun pääsen siellä johonkin kylään, voin jatkaa yksin. Erämaamatkalla turvautuisin kuitenkin mielelläni reitin tuntevaan ihmiseen, joka osaa pitää kulkijan turvassa.;{};"{""v1"":{""type"":""grammar_component""}}";;;;;m;;;;;1;finnish_translation;
u_1108a41dff1e85b712fd;message;exact;Would you be able to take me to the nearest village? To any village at all with decent folk where I could rest and clear my head. After how terribly lost I got I really need to travel in a company.;Voisitko viedä minut lähimpään kylään? Mihin tahansa kunnon väen kylään, jossa voisin levätä ja selvitellä päätäni. Eksyttyäni niin pahasti tarvitsen todella matkaseuraa.;{};{};;;;;m;;;;;1;finnish_translation;
u_fc86d1a24c7a35bdc6c1;message;template;Would you please just walk me to the village, {v1}.;Saata minut vain kylään, ole hyvä, {v1}.;{};"{""v1"":{""type"":""text""}}";;;;;m;;;;;1;finnish_translation;
u_0bbe8c8df4fd6e1c92b6;message;exact;Wounded and left for dead, you struggle to survive in the wilderness. ;Haavoittuneena ja kuolemaan jätettynä kamppailet selviytyäksesi erämaassa. ;{};{};;;;{};m;;;;;1;finnish_translation;
u_73b42fa5ab2851d4d784;message;exact;Wounds and injuries;Haavat ja vammat;{};{};;;;{};m;;;;;1;finnish_translation;
